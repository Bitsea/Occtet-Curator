<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260902-add-idx-file-inventory-item-link-file-id" author="occtet">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_file_inv_item_link_file_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_file_inv_item_link_file_id" tableName="file_inventory_item_link">
            <column name="file_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260902-add-idx-copyright-file-link-file-id" author="occtet">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_copyright_file_link_file_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_copyright_file_link_file_id" tableName="copyright_file_link">
            <column name="file_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>