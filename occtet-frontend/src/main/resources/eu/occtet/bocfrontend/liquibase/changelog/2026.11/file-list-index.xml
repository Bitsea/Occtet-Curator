<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Supports the file list view: where project_id = ? and is_directory = false order by project_path -->
    <changeSet id="20261119-add-idx-file-project-dir-path" author="occtet">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_file_project_dir_path"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_file_project_dir_path" tableName="file">
            <column name="project_id"/>
            <column name="is_directory"/>
            <column name="project_path"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
